{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": "..",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true
  },
  "include": [
    "src/cli.ts",
    "../backend/src/services/crawlerService.ts",
    "../backend/src/services/googleDriveService.ts",
    "../backend/src/routes/driveHelpers.ts",
    "../backend/src/types/index.ts"
  ]
}
