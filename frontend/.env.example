# Development: leave empty — Vite proxy handles /api → localhost:5000
VITE_API_URL=

# Production (set in Cloudflare Pages dashboard under Settings → Environment Variables):
# VITE_API_URL=https://neural-network-backend.YOUR_SUBDOMAIN.workers.dev

# Optional: solo crawler worker URL. When set, /run and /run-all hit this worker
# instead of the main API. Leave empty to keep crawler routed through main API.
# VITE_CRAWLER_URL=https://neural-network-crawler.YOUR_SUBDOMAIN.workers.dev
