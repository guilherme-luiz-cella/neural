# Used by wrangler dev (local dev only — .dev.vars file is the actual local secrets file)
# Copy to .dev.vars and fill in real values

SUPABASE_URL=d
SUPABASE_SERVICE_KEY=eyJ...your-service-role-key-from-supabase-dashboard...
JWT_SECRET=change-this-to-a-long-random-secret

# Found at: Supabase Dashboard → Settings → API → service_role key
# NEVER commit .dev.vars
